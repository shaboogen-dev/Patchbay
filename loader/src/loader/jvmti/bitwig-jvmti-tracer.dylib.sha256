include/darwin/jni_md.h=e7b2b9ba31ff7753e80747c14731d626155758b733e225dfd9074f722b35c108
build-agent-mac.sh=86ed6c1d44dfb3b304847e8fbd35d3c2816e871b291c4e839fe7f196d8a6d94c
jdk-include/jni.h=6059b8dcdfed1f6299006bb6e8d7a72f2344eedfaa74650281a39fd634afdbbc
