@echo off
setlocal EnableExtensions EnableDelayedExpansion
set "HERE=%~dp0"
set "DLL=%HERE%bin\bitwig-jvmti-tracer.dll"
set "SESSION=%HERE%bin\session.conf"
set "TARGETS=%HERE%targets.tsv"
if defined BITWIG_TRACE_TARGETS set "TARGETS=%BITWIG_TRACE_TARGETS%"
set "ACTIVE=%HERE%active-session.txt"
set "TRACE_ENABLED=%BML_TRACE_ENABLED%"
if not defined TRACE_ENABLED set "TRACE_ENABLED=0"
if /I "%TRACE_ENABLED%"=="true" set "TRACE_ENABLED=1"
if not "%TRACE_ENABLED%"=="1" set "TRACE_ENABLED=0"

if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Checking native JVMTI loader binary...
if not exist "%DLL%" (
  echo Native loader DLL is not built yet. Building it now...
  call "%HERE%build-native.cmd"
  if errorlevel 1 exit /b %ERRORLEVEL%
)

if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Native loader binary is ready. Verifying Bitwig is not already running...

rem Exact JVMTI capabilities and class-load hooks must be acquired when this JVM starts.
tasklist /FI "IMAGENAME eq BitwigStudioApp.exe" /NH 2>nul | find /I "BitwigStudioApp.exe" >nul
if not errorlevel 1 (
  echo ERROR: BitwigStudioApp.exe is already running.
  echo Close Bitwig normally, then run this launcher again so the agent is present at JVM startup.
  exit /b 5
)

set "BITWIG_EXE=%~1"
if not defined BITWIG_EXE set "BITWIG_EXE=%ProgramFiles%\Bitwig Studio\Bitwig Studio.exe"
if not exist "%BITWIG_EXE%" (
  echo ERROR: Bitwig launcher not found at:
  echo   %BITWIG_EXE%
  echo Pass the full path as the first argument, for example:
  echo   launch-bitwig-agent.cmd "D:\Apps\Bitwig Studio\Bitwig Studio.exe"
  exit /b 6
)

if defined BML_SESSION_ID (
  set "TS=%BML_SESSION_ID%"
) else (
  for /f %%T in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd-HHmmss"') do set "TS=%%T"
)
if not defined TS set "TS=unknown"
set "REPORT="
set "TRACE="
set "CONTROL="
if "%TRACE_ENABLED%"=="1" (
  if defined BML_SESSION_TRACE_ROOT (
    set "REPORT=%BML_SESSION_TRACE_ROOT%"
  ) else (
    set "REPORT=%HERE%reports\trace-%TS%"
  )
  set "TRACE=!REPORT!\trace.tsv"
  set "CONTROL=!REPORT!\control.txt"
  if not exist "!REPORT!" mkdir "!REPORT!"
)

if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Writing JVMTI session configuration ^(trace=%TRACE_ENABLED%^) ...
>"%SESSION%" echo # Generated by launch-bitwig-agent.cmd
>>"%SESSION%" echo trace_enabled=%TRACE_ENABLED%
if "%TRACE_ENABLED%"=="1" (
  >>"%SESSION%" echo targets=%TARGETS%
  >>"%SESSION%" echo out=!TRACE!
  >>"%SESSION%" echo control=!CONTROL!
  >>"%SESSION%" echo stack=16
  >>"%SESSION%" echo receiver=1
  >>"%SESSION%" echo values=1
  >>"%SESSION%" echo tags=1
  >>"%SESSION%" echo strings=1
  >>"%SESSION%" echo string_limit=160
  >>"%SESSION%" echo inventory_classes=xyK,Gg3,Unc,K2Z,Itn,boJ,boo
  >>"%SESSION%" echo inventory_methods=
)
if defined BITWIG_CLASS_HOOK_MODE >>"%SESSION%" echo class_hook=%BITWIG_CLASS_HOOK_MODE%
if defined BITWIG_REPLACEMENT_CLASS >>"%SESSION%" echo replacement_class=%BITWIG_REPLACEMENT_CLASS%
if defined BITWIG_REPLACEMENT_OWNER >>"%SESSION%" echo replacement_owner=%BITWIG_REPLACEMENT_OWNER%
if defined BITWIG_REPLACEMENT_MAP >>"%SESSION%" echo replacement_map=%BITWIG_REPLACEMENT_MAP%
if defined BITWIG_HELPER_JAR >>"%SESSION%" echo helper_jar=%BITWIG_HELPER_JAR%

>"%ACTIVE%" echo session_id=%TS%
>>"%ACTIVE%" echo mode=modded
>>"%ACTIVE%" echo trace_enabled=%TRACE_ENABLED%
if "%TRACE_ENABLED%"=="1" (
  >>"%ACTIVE%" echo report=!REPORT!
  >>"%ACTIVE%" echo trace=!TRACE!
  >>"%ACTIVE%" echo control=!CONTROL!
  >>"%ACTIVE%" echo targets=%TARGETS%
)
if defined BITWIG_REPLACEMENT_MAP >>"%ACTIVE%" echo replacement_map=%BITWIG_REPLACEMENT_MAP%
if defined BITWIG_HELPER_JAR >>"%ACTIVE%" echo helper_jar=%BITWIG_HELPER_JAR%
>>"%ACTIVE%" echo launched=%TS%
if defined BML_ENABLED_MOD_IDS >>"%ACTIVE%" echo mod_ids=%BML_ENABLED_MOD_IDS%

if "%TRACE_ENABLED%"=="1" (
  if defined BITWIG_ACCEPTANCE_LOG_IN_REPORT set "BITWIG_RE_ACCEPTANCE_LOG=!REPORT!\action-binding-acceptance.log"
  if defined BITWIG_MOD_LOG_IN_REPORT set "BITWIG_RE_MOD_LOG=!REPORT!\mod.log"
)

if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Session metadata prepared; launching Bitwig with the loader agent attached at JVM startup...
set "OLD_JAVA_TOOL_OPTIONS=%JAVA_TOOL_OPTIONS%"
set "JAVA_TOOL_OPTIONS=%JAVA_TOOL_OPTIONS% -agentpath:"%DLL%""
if "%TRACE_ENABLED%"=="1" (
  echo Launching Bitwig with BML loader agent and Debug Mode tracing...
  echo Targets: %TARGETS%
) else (
  echo Launching Bitwig with BML loader agent ^(Debug Mode off; tracing disabled^)...
)
rem Launch asynchronously without attaching Bitwig's launcher wrapper to this console.
rem UseShellExecute=false preserves the current environment, including JAVA_TOOL_OPTIONS.
rem CreateNoWindow prevents a console-mode launcher wrapper from owning this cmd session;
rem it does not suppress Bitwig's GUI.
powershell -NoProfile -NonInteractive -Command "$ErrorActionPreference = 'Stop'; $psi = New-Object System.Diagnostics.ProcessStartInfo; $psi.FileName = $env:BITWIG_EXE; $psi.WorkingDirectory = [IO.Path]::GetDirectoryName($env:BITWIG_EXE); $psi.UseShellExecute = $false; $psi.CreateNoWindow = $true; $p = [System.Diagnostics.Process]::Start($psi); if ($null -eq $p) { exit 1 }"
set "LAUNCH_RC=%ERRORLEVEL%"
set "JAVA_TOOL_OPTIONS=%OLD_JAVA_TOOL_OPTIONS%"
if not "%LAUNCH_RC%"=="0" (
  echo ERROR: Failed to start Bitwig launcher process.
  exit /b 9
)

if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Bitwig launcher started; waiting for BitwigStudioApp.exe...
set "PID="
for /L %%N in (1,1,30) do (
  set "PID="
  for /f "delims=" %%P in ('powershell -NoProfile -Command "$p=@(Get-Process -Name BitwigStudioApp -ErrorAction SilentlyContinue); if($p.Count -ne 0){[Console]::Write([string]$p[0].Id)}"') do set "PID=%%P"
  if defined PID (
    set "BADPID="
    for /f "delims=0123456789" %%X in ("!PID!") do set "BADPID=%%X"
    if defined BADPID set "PID="
  )
  if defined PID goto got_pid
  rem timeout.exe fails immediately when the launcher has redirected input from BML.
  rem PowerShell is already required above and its sleep works with redirected stdin.
  powershell -NoProfile -NonInteractive -Command "Start-Sleep -Milliseconds 1000" >nul
)
echo ERROR: BitwigStudioApp.exe did not appear within 30 seconds.
exit /b 7

:got_pid
if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Bitwig JVM process detected: PID %PID%.
>>"%ACTIVE%" echo pid=%PID%
echo Bitwig JVM PID: %PID%

if not "%TRACE_ENABLED%"=="1" goto loader_ready

if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Waiting up to 90 seconds for Debug Mode tracer initialization/control file...
rem A single noninteractive PowerShell poller avoids timeout.exe's redirected-stdin failure.
rem The unique session control path is carried through the environment to avoid quoting issues.
rem Require a populated "loaded" status, not just a file created before its first write.
set "BML_WAIT_TRACE_CONTROL=!CONTROL!"
powershell -NoProfile -NonInteractive -Command "$deadline=[DateTime]::UtcNow.AddSeconds(90); while ([DateTime]::UtcNow -lt $deadline) { try { if ([IO.File]::Exists($env:BML_WAIT_TRACE_CONTROL)) { $status=[IO.File]::ReadAllText($env:BML_WAIT_TRACE_CONTROL).Trim(); if ($status.StartsWith('loaded')) { exit 0 } } } catch [System.IO.IOException] { }; Start-Sleep -Milliseconds 250 }; exit 8"
if not errorlevel 1 goto agent_ready
echo WARNING: Bitwig started, but the tracer did not confirm initialization within 90 seconds.
echo Check whether Bitwig displayed a JVM/agent startup error. Normal Bitwig launches are unaffected because JAVA_TOOL_OPTIONS was only set for this child process.
echo Session metadata: %ACTIVE%
exit /b 8

:agent_ready
if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Tracer initialization confirmed; BML debug session is ready.
echo.
echo Loader agent started successfully with Debug Mode tracing:
type "!CONTROL!"
echo.
echo Trace: !TRACE!
echo Bitwig is running with the prepared external mods.
exit /b 0

:loader_ready
if "%BML_DEBUG_VERBOSE%"=="1" echo [BML debug] Loader agent initialization confirmed; session is ready without tracing.
echo.
echo Loader agent started successfully. Debug Mode is off; no trace report was created.
echo Bitwig is running with the prepared external mods.
exit /b 0
